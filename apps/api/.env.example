# Copy to .env (gitignored). Generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
PORT=3002
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/delivery
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change_me_generate_64_random_chars_minimum
JWT_REFRESH_SECRET=change_me_generate_64_random_chars_minimum
CORS_ORIGINS=http://localhost:3001
GOOGLE_MAPS_API_KEY=